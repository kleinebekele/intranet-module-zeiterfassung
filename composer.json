{
    "name": "do1emu/module-zeiterfassung",
    "description": "Zeiterfassungs-Modul für die modulare Intranet-Plattform: https://github.com/kleinebekele/intranet-core",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "intranet", "modul", "zeiterfassung", "arbeitszeit", "terminal"],
    "authors": [
        {
            "name": "do1emu"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Intranet\\Modules\\Zeiterfassung\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Intranet\\Modules\\Zeiterfassung\\ZeiterfassungServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
